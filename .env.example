# OceanEmbed Credentials Configuration Template
# Copy this file to .env and fill in your real credentials (never commit .env)

# Copernicus Marine Service (CMEMS)
CMEMS_USERNAME=your_cmems_username
CMEMS_PASSWORD=your_cmems_password

# NASA Earthdata (GES DISC / Ocean Color)
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# ISRO / MOSDAC
MOSDAC_USERNAME=your_mosdac_username
MOSDAC_PASSWORD=your_mosdac_password
